{% extends "base.html.j2" %}
{% block title %}Minhas candidaturas{% endblock %}

{% block content %}

<h2 class="mb-4 fw-bold">Minhas candidaturas</h2>

<table class="table table-striped table-hover shadow-sm">
    <thead class="table-primary">
        <tr>
            <th>Vaga</th>
            <th>Empresa</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        {% for c in candidaturas %}
        <tr>
            <td>{{ c.vaga.titulo }}</td>
            <td>{{ c.vaga.empresa.nome }}</td>
            <td>
                <span class="badge bg-
                    {% if c.status == 'pendente' %}warning
                    {% elif c.status == 'aceite' %}success
                    {% else %}danger{% endif %}
                ">
                    {{ c.status }}
                </span>
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>

{% endblock %}
