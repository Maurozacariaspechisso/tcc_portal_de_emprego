<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
  <div class="container">

    <!-- LOGO -->
    <a class="navbar-brand" href="{{ url_for('main.index') }}">
      Portal de Emprego
    </a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
            data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNav">

      <!-- LINKS PRINCIPAIS -->
      <ul class="navbar-nav me-auto">

        <!-- VISÍVEL PARA TODOS -->
        <li class="nav-item">
          <a class="nav-link" href="{{ url_for('vagas.listar_vagas') }}">
            Vagas
          </a>
        </li>

        {% if current_user.is_authenticated %}

          {% if current_user.role == "empresa" %}
            <li class="nav-item">
              <a class="nav-link" href="{{ url_for('vagas.nova_vaga') }}">
                Publicar Vaga
              </a>
            </li>

            <li class="nav-item">
              <a class="nav-link" href="{{ url_for('vagas.candidaturas_empresa') }}">
                Candidaturas
              </a>
            </li>
          {% endif %}

          {% if current_user.role == "candidato" %}
            <li class="nav-item">
              <a class="nav-link" href="{{ url_for('candidaturas.minhas_candidaturas') }}">
                Minhas Candidaturas
              </a>
            </li>
          {% endif %}

        {% endif %}
      </ul>

      <!-- PESQUISA -->
      <form class="d-flex" method="get" action="{{ url_for('vagas.listar_vagas') }}">
        <input class="form-control me-2" type="search" name="q"
               placeholder="Pesquisar vagas">
        <button class="btn btn-outline-light" type="submit">
          Pesquisar
        </button>
      </form>

      <!-- AUTENTICAÇÃO -->
      <ul class="navbar-nav ms-3">

        {% if current_user.is_authenticated %}
          <li class="nav-item">
            <span class="navbar-text me-2">
              {{ current_user.email }}
            </span>
          </li>

          <li class="nav-item">
            <a class="nav-link" href="{{ url_for('auth.logout') }}">
              Sair
            </a>
          </li>
        {% else %}
          <li class="nav-item">
            <a class="nav-link" href="{{ url_for('auth.login') }}">
              Login
            </a>
          </li>

          <li class="nav-item">
            <a class="nav-link" href="{{ url_for('auth.register') }}">
              Registar
            </a>
          </li>
        {% endif %}

      </ul>
    </div>
  </div>
</nav>
