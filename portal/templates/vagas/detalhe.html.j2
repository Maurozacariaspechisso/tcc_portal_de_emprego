{% extends "base.html.j2" %}

{% block title %}{{ vaga.titulo }}{% endblock %}

{% block content %}
<div class="container mt-4">

    <h2>{{ vaga.titulo }}</h2>
    <p class="text-muted">
        {{ vaga.empresa.nome_empresa }} · {{ vaga.localizacao }}
    </p>

    <hr>

    <h5>Descrição da Vaga</h5>
    <p>{{ vaga.descricao }}</p>

    <h5>Requisitos</h5>
    <p>{{ vaga.requisitos }}</p>

    {% if vaga.salario %}
        <h5>Salário</h5>
        <p>{{ vaga.salario }}</p>
    {% endif %}

    <hr>

    {% if current_user.is_authenticated and current_user.role == "candidato" %}
        {% if ja_candidatou %}
            <div class="alert alert-info">
                Você já se candidatou a esta vaga.
            </div>
        {% else %}
            <form
                method="POST"
                action="{{ url_for('candidaturas.candidatar', vaga_id=vaga.id) }}"
            >
                <button type="submit" class="btn btn-success">
                    Candidatar-se
                </button>
            </form>
        {% endif %}
    {% else %}
        <div class="alert alert-warning">
            Faça login como candidato para se candidatar a esta vaga.
        </div>
    {% endif %}

    <a href="{{ url_for('vagas.listar_vagas') }}" class="btn btn-link mt-3">
        ← Voltar para vagas
    </a>

</div>
{% endblock %}
