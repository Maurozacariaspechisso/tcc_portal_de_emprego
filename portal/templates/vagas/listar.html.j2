{% extends "base.html.j2" %}

{% block content %}
<div class="container mt-4">

    <!-- TÍTULO -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Vagas Disponíveis</h2>
    </div>

    <!-- BARRA DE PESQUISA -->
    <form method="GET" action="{{ url_for('vagas.listar_vagas') }}" class="mb-4">
        <div class="input-group">
            <input type="text"
                   name="q"
                   class="form-control"
                   placeholder="Pesquisar por título, localização..."
                   value="{{ request.args.get('q', '') }}">
            <button class="btn btn-primary" type="submit">
                Pesquisar
            </button>
        </div>
    </form>

    <!-- LISTA DE VAGAS -->
    {% if vagas %}

        {% for vaga in vagas %}
        <div class="card shadow-sm mb-3">
            <div class="card-body">

                <div class="d-flex justify-content-between">
                    <div>
                        <h5 class="card-title mb-1">
                            {{ vaga.titulo }}
                        </h5>

                        <small class="text-muted">
                            {{ vaga.localizacao }} |
                            Publicada em {{ vaga.data_postagem.strftime('%d/%m/%Y') }}
                        </small>
                    </div>

                    {% if vaga.salario %}
                    <div class="text-end">
                        <span class="badge bg-success">
                            {{ vaga.salario }}
                        </span>
                    </div>
                    {% endif %}
                </div>

                <hr>

                <p class="card-text">
                    {{ vaga.descricao[:180] }}{% if vaga.descricao|length > 180 %}...{% endif %}
                </p>

                <div class="d-flex justify-content-between align-items-center">

                    <!-- BOTÃO DETALHES -->
                    <a href="{{ url_for('vagas.detalhe_vaga', vaga_id=vaga.id) }}"
                       class="btn btn-outline-primary btn-sm">
                        Ver detalhes
                    </a>

                    <!-- BOTÃO CANDIDATAR -->
                    {% if current_user.is_authenticated and current_user.role == "candidato" %}
                        <form method="POST"
                              action="{{ url_for('candidaturas.candidatar', vaga_id=vaga.id) }}">
                            <button type="submit"
                                    class="btn btn-success btn-sm">
                                Candidatar-se
                            </button>
                        </form>
                    {% endif %}

                </div>

            </div>
        </div>
        {% endfor %}

    {% else %}
        <div class="alert alert-info text-center">
            Nenhuma vaga encontrada.
        </div>
    {% endif %}

</div>
{% endblock %}
