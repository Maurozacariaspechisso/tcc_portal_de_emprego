{% extends "base.html.j2" %}

{% block title %}Vagas Disponíveis{% endblock %}

{% block content %}
<div class="container mt-4">

    <h2 class="mb-4">Vagas Disponíveis</h2>

    {% if vagas %}
        <div class="list-group">
            {% for vaga in vagas %}
                <div class="list-group-item mb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5>
                                <a href="{{ url_for('vagas.detalhe_vaga', vaga_id=vaga.id) }}">
                                    {{ vaga.titulo }}
                                </a>
                            </h5>
                            <p class="mb-1">{{ vaga.descricao[:150] }}{% if vaga.descricao|length > 150 %}...{% endif %}</p>
                            <small class="text-muted">
                                Local: {{ vaga.localizacao }} | Salário: {{ vaga.salario if vaga.salario else "Não informado" }}
                            </small>
                        </div>
                        {% if current_user.is_authenticated and current_user.role == 'candidato' %}
                            <form action="{{ url_for('candidaturas.candidatar', vaga_id=vaga.id) }}" method="POST">
                                <button type="submit" class="btn btn-primary btn-sm">Candidatar-se</button>
                            </form>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <p>Nenhuma vaga disponível no momento.</p>
    {% endif %}

</div>
{% endblock %}
